terraform {
  required_version = ">= 1.6.0"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }
}

# GitHub Actions supplies ARM_CLIENT_ID, ARM_TENANT_ID, ARM_SUBSCRIPTION_ID, configure this from Github Settings

provider "azurerm" {
  features {}
}